# --- Postgres ---
POSTGRES_USER=hga
POSTGRES_PASSWORD=hga

# --- Keycloak admin console (http://localhost:8080) ---
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# --- Backend ---
